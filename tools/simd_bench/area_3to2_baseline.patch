diff --git a/ms912x_downscale.h b/ms912x_downscale.h
index 6bd7041..cb7d62d 100644
--- a/ms912x_downscale.h
+++ b/ms912x_downscale.h
@@ -5,0 +6 @@
+#include <linux/kernel.h>
@@ -13,3 +14,7 @@
-/* Round the four samples once, independently for all four byte channels. */
-static __always_inline u32 ms912x_downscale_avg4(u32 p00, u32 p01,
-						 u32 p10, u32 p11)
+/*
+ * Exact 3->2 area filter. For each axis the phases use weights (2,1) and
+ * (1,2). Select the weight-2 sample first, then round only after both axes:
+ * (4*a + 2*b + 2*c + d + 4) / 9. All four byte channels are preserved.
+ */
+static __always_inline u32
+ms912x_downscale_area_channel(u32 a, u32 b, u32 c, u32 d, unsigned int shift)
@@ -17,6 +22,3 @@ static __always_inline u32 ms912x_downscale_avg4(u32 p00, u32 p01,
-	const u32 high_mask = 0x3f3f3f3f;
-	const u32 low_mask = 0x03030303;
-	u32 high = ((p00 >> 2) & high_mask) + ((p01 >> 2) & high_mask) +
-		   ((p10 >> 2) & high_mask) + ((p11 >> 2) & high_mask);
-	u32 low = (p00 & low_mask) + (p01 & low_mask) +
-		  (p10 & low_mask) + (p11 & low_mask) + 0x02020202;
+	unsigned int sum = 4 * ((a >> shift) & 255) +
+			   2 * ((b >> shift) & 255) +
+			   2 * ((c >> shift) & 255) + ((d >> shift) & 255);
@@ -24 +26,18 @@ static __always_inline u32 ms912x_downscale_avg4(u32 p00, u32 p01,
-	return high + ((low >> 2) & low_mask);
+	return (sum + 4) / 9;
+}
+
+static __always_inline u32
+ms912x_downscale_area_pixel(const u32 *heavy, const u32 *light,
+			    unsigned int src_width, unsigned int x)
+{
+	unsigned int sx = x + x / 2;
+	unsigned int phase = x & 1;
+	unsigned int near = min(sx + phase, src_width - 1);
+	unsigned int center = min(sx + 1 - phase, src_width - 1);
+	u32 a = heavy[near], b = heavy[center];
+	u32 c = light[near], d = light[center];
+
+	return ms912x_downscale_area_channel(a, b, c, d, 0) |
+	       (ms912x_downscale_area_channel(a, b, c, d, 8) << 8) |
+	       (ms912x_downscale_area_channel(a, b, c, d, 16) << 16) |
+	       (ms912x_downscale_area_channel(a, b, c, d, 24) << 24);
@@ -35 +54 @@ typedef void (*ms912x_downscale_fn)(const u32 *src, u32 *dst,
-void ms912x_downscale_xrgb8888_2x_scalar(const u32 *src, u32 *dst,
+void ms912x_downscale_xrgb8888_3to2_scalar(const u32 *src, u32 *dst,
@@ -42 +61 @@ void ms912x_downscale_xrgb8888_2x_scalar(const u32 *src, u32 *dst,
-void ms912x_downscale_xrgb8888_2x(const u32 *src, u32 *dst,
+void ms912x_downscale_xrgb8888_3to2(const u32 *src, u32 *dst,
@@ -51 +70 @@ void ms912x_downscale_xrgb8888_2x(const u32 *src, u32 *dst,
-void ms912x_downscale_xrgb8888_2x_sse2(const u32 *src, u32 *dst,
+void ms912x_downscale_xrgb8888_3to2_sse2(const u32 *src, u32 *dst,
@@ -58 +77 @@ void ms912x_downscale_xrgb8888_2x_sse2(const u32 *src, u32 *dst,
-void ms912x_downscale_xrgb8888_2x_avx2(const u32 *src, u32 *dst,
+void ms912x_downscale_xrgb8888_3to2_avx2(const u32 *src, u32 *dst,
@@ -68 +87 @@ void ms912x_downscale_xrgb8888_2x_avx2(const u32 *src, u32 *dst,
-void ms912x_downscale_xrgb8888_2x_neon_rows_fpu(
+void ms912x_downscale_xrgb8888_3to2_neon_rows_fpu(
@@ -73 +92 @@ void ms912x_downscale_xrgb8888_2x_neon_rows_fpu(
-void ms912x_downscale_xrgb8888_2x_neon(const u32 *src, u32 *dst,
+void ms912x_downscale_xrgb8888_3to2_neon(const u32 *src, u32 *dst,
