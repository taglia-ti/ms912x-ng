+		const u32 *heavy = src + min(sy + phase, src_height - 1) * src_stride;
+		const u32 *light = src + min(sy + 1 - phase, src_height - 1) * src_stride;
@@ -26,7 +21,2 @@ void ms912x_downscale_xrgb8888_2x_scalar(const u32 *src, u32 *dst,
-		for (x = 0; x < dst_width; x++) {
-			unsigned int sx0 = min(2 * x, src_width - 1);
-			unsigned int sx1 = min(2 * x + 1, src_width - 1);
-
-			out[x] = ms912x_downscale_avg4(row0[sx0], row0[sx1],
-						       row1[sx0], row1[sx1]);
-		}
+		for (x = 0; x < dst_width; x++)
+			out[x] = ms912x_downscale_area_pixel(heavy, light, src_width, x);
diff --git a/ms912x_downscale_sse.h b/ms912x_downscale_sse.h
index f96f028..a5558d4 100644
--- a/ms912x_downscale_sse.h
+++ b/ms912x_downscale_sse.h
@@ -5,5 +5,12 @@
-/*
- * PAVGB rounds each pair up. Correct the extra rounding of the second PAVGB:
- * subtract one when a pair sum is odd and the two pair averages differ in parity.
- * This is exactly (a + b + c + d + 2) >> 2, including the X/alpha byte.
- */
+/* Four output pixels consume six input pixels, with no row-tail overread. */
+static __always_inline void
+ms912x_downscale_sse_gather_four(const u32 *row, __m128i *near, __m128i *center)
+{
+	__m128 a = _mm_castsi128_ps(_mm_loadu_si128((const __m128i *)row));
+	__m128 b = _mm_castsi128_ps(_mm_loadu_si128((const __m128i *)(row + 2)));
+
+	/* Weight-2 samples: 0,2,3,5; weight-1 samples: 1,1,4,4. */
+	*near = _mm_castps_si128(_mm_shuffle_ps(a, b, _MM_SHUFFLE(3, 1, 2, 0)));
+	*center = _mm_castps_si128(_mm_shuffle_ps(a, b, _MM_SHUFFLE(2, 2, 1, 1)));
+}
+
@@ -11 +18 @@ static __always_inline __m128i
-ms912x_downscale_sse_avg4(__m128i a, __m128i b, __m128i c, __m128i d)
+ms912x_downscale_sse_sum(__m128i a, __m128i b, __m128i c, __m128i d)
@@ -13,4 +20,2 @@ ms912x_downscale_sse_avg4(__m128i a, __m128i b, __m128i c, __m128i d)
-	__m128i ab = _mm_avg_epu8(a, b);
-	__m128i cd = _mm_avg_epu8(c, d);
-	__m128i odd = _mm_or_si128(_mm_xor_si128(a, b), _mm_xor_si128(c, d));
-	__m128i correction = _mm_and_si128(odd, _mm_xor_si128(ab, cd));
+	__m128i heavy = _mm_add_epi16(_mm_slli_epi16(a, 1), b);
+	__m128i light = _mm_add_epi16(_mm_slli_epi16(c, 1), d);
@@ -18,2 +23,8 @@ ms912x_downscale_sse_avg4(__m128i a, __m128i b, __m128i c, __m128i d)
-	correction = _mm_and_si128(correction, _mm_set1_epi8(1));
-	return _mm_sub_epi8(_mm_avg_epu8(ab, cd), correction);
+	return _mm_add_epi16(_mm_slli_epi16(heavy, 1), light);
+}
+
+static __always_inline __m128i ms912x_downscale_sse_div9(__m128i sum)
+{
+	/* Exact floor((sum+4)/9) for 0 <= sum <= 2295; no SIMD division. */
+	return _mm_mulhi_epu16(_mm_add_epi16(sum, _mm_set1_epi16(4)),
+			     _mm_set1_epi16(7282));
@@ -23 +34 @@ static __always_inline __m128i
-ms912x_downscale_sse_four(const u32 *row0, const u32 *row1)
+ms912x_downscale_sse_four(const u32 *heavy, const u32 *light)
@@ -25,10 +36,23 @@ ms912x_downscale_sse_four(const u32 *row0, const u32 *row1)
-	__m128 r00 = _mm_castsi128_ps(_mm_loadu_si128((const __m128i *)row0));
-	__m128 r01 = _mm_castsi128_ps(_mm_loadu_si128((const __m128i *)(row0 + 4)));
-	__m128 r10 = _mm_castsi128_ps(_mm_loadu_si128((const __m128i *)row1));
-	__m128 r11 = _mm_castsi128_ps(_mm_loadu_si128((const __m128i *)(row1 + 4)));
-	__m128i even0 = _mm_castps_si128(_mm_shuffle_ps(r00, r01, _MM_SHUFFLE(2, 0, 2, 0)));
-	__m128i odd0 = _mm_castps_si128(_mm_shuffle_ps(r00, r01, _MM_SHUFFLE(3, 1, 3, 1)));
-	__m128i even1 = _mm_castps_si128(_mm_shuffle_ps(r10, r11, _MM_SHUFFLE(2, 0, 2, 0)));
-	__m128i odd1 = _mm_castps_si128(_mm_shuffle_ps(r10, r11, _MM_SHUFFLE(3, 1, 3, 1)));
-
-	return ms912x_downscale_sse_avg4(even0, even1, odd0, odd1);
+	__m128i a, b, c, d, lo, hi;
+	__m128i zero = _mm_setzero_si128();
+
+	ms912x_downscale_sse_gather_four(heavy, &a, &b);
+	ms912x_downscale_sse_gather_four(light, &c, &d);
+	lo = ms912x_downscale_sse_sum(_mm_unpacklo_epi8(a, zero),
+		_mm_unpacklo_epi8(b, zero), _mm_unpacklo_epi8(c, zero),
+		_mm_unpacklo_epi8(d, zero));
+	hi = ms912x_downscale_sse_sum(_mm_unpackhi_epi8(a, zero),
+		_mm_unpackhi_epi8(b, zero), _mm_unpackhi_epi8(c, zero),
+		_mm_unpackhi_epi8(d, zero));
+	return _mm_packus_epi16(ms912x_downscale_sse_div9(lo),
+			       ms912x_downscale_sse_div9(hi));
+}
+
+static __always_inline void
+ms912x_downscale_sse_gather_two(const u32 *row, __m128i *near, __m128i *center)
+{
+	__m128i first = _mm_loadl_epi64((const __m128i *)row);
+	__m128i last = _mm_cvtsi32_si128(row[2]);
+
+	*near = _mm_unpacklo_epi32(first, last);
+	*center = _mm_shuffle_epi32(first, _MM_SHUFFLE(1, 1, 1, 1));
@@ -38 +62 @@ static __always_inline __m128i
-ms912x_downscale_sse_two(const u32 *row0, const u32 *row1)
+ms912x_downscale_sse_two(const u32 *heavy, const u32 *light)
@@ -40,13 +64,9 @@ ms912x_downscale_sse_two(const u32 *row0, const u32 *row1)
-	__m128i a = _mm_loadu_si128((const __m128i *)row0);
-	__m128i b = _mm_loadu_si128((const __m128i *)row1);
-	__m128i ab = _mm_avg_epu8(a, b);
-	__m128i parity = _mm_xor_si128(a, b);
-	__m128i adjacent = _mm_shuffle_epi32(ab, _MM_SHUFFLE(2, 3, 0, 1));
-	__m128i pair_parity = _mm_shuffle_epi32(parity, _MM_SHUFFLE(2, 3, 0, 1));
-	__m128i correction = _mm_and_si128(_mm_or_si128(parity, pair_parity),
-					 _mm_xor_si128(ab, adjacent));
-	__m128i average;
-
-	correction = _mm_and_si128(correction, _mm_set1_epi8(1));
-	average = _mm_sub_epi8(_mm_avg_epu8(ab, adjacent), correction);
-	return _mm_shuffle_epi32(average, _MM_SHUFFLE(2, 0, 2, 0));
+	__m128i a, b, c, d, sum;
+	__m128i zero = _mm_setzero_si128();
+
+	ms912x_downscale_sse_gather_two(heavy, &a, &b);
+	ms912x_downscale_sse_gather_two(light, &c, &d);
+	sum = ms912x_downscale_sse_sum(_mm_unpacklo_epi8(a, zero),
+		_mm_unpacklo_epi8(b, zero), _mm_unpacklo_epi8(c, zero),
+		_mm_unpacklo_epi8(d, zero));
+	return _mm_packus_epi16(ms912x_downscale_sse_div9(sum), zero);
